
@{
    ViewBag.Title = "GenerateRevenueReport";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Consolidated General Revenue</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">Generate Revenue Report</div>
            <div class="panel-body">
                <div class="table-container1">
                    <div class="row table-top">
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>Org.Name:</label>
                                <select id="ddlInstitute" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>   Starting Date:</label>
                                <div class="input-group date" id="dtStaringDate">
                                    <input id="txtStaringDate" type="text" class="form-control">
                                    <span class="input-group-addon">
                                        <i class="glyphicon glyphicon-th"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>  Ending Date:</label>
                                <div class="input-group date" id="dtEndingDate">
                                    <input id="txtEndingDate" type="text" class="form-control">
                                    <span class="input-group-addon">
                                        <i class="glyphicon glyphicon-th"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" id="btnView" class="btn btn-primary btn-column">View</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">
                <h3 class="panel-title">Revenue Report</h3>
                <span class="pull-right">
                    <ul class="nav panel-tabs" id="reportTabs">
                        <li class="active"><a href="#tabIncomeExpenditure" data-toggle="tab">Consolidated General Revenue</a></li>
                        <li><a href="#tabStatement" data-toggle="tab">Consolidated Statement of I&E</a></li>
                        <li><a href="#tabStatementShort" data-toggle="tab">Statement of I&E Short</a></li>
                        <li><a href="#tabScheduleD" data-toggle="tab">Schedule-D</a></li>
                    </ul>
                </span>
            </div>
            <div class="panel-body">
                <div class="tab-content">
                    <div class="tab-pane active" id="tabIncomeExpenditure">
                        <div class="panel panel-default panel-primary2">                          
                            <div class="panel-body">
                                <div class="table-container">
                                    <table id="tblIncomeExpenditure" class="table table-striped table-bordered table-hover main-table">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>Name Of Organization</th>
                                                <th className="align-right">Deflict</th>
                                                <th>Name Of Organization</th>
                                                <th className="align-right">Surplus</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tabStatement">
                        <div class="panel panel-default panel-primary2">                           
                            <div class="panel-body">
                                <div class="table-container">
                                    <table id="tblStatement" class="table table-striped table-bordered table-hover main-table">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>Name Of Organization</th>
                                                <th className="align-right">Sch.D</th>
                                                <th className="align-right">Receipt</th>
                                                <th className="align-right">Expenses</th>
                                                <th className="align-right">Expenses Without Sch.D</th>
                                                <th className="align-right">Net Saving</th>
                                                <th className="align-right">Net Saving  Without Sch.D</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tabStatementShort">
                        <div class="panel panel-default panel-primary2">                         
                            <div class="panel-body">
                                <div class="table-container">
                                    <table id="tblStatementShort" class="table table-striped table-bordered table-hover main-table">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>Name Of Organization</th>
                                                <th className="align-right">Receipt</th>
                                                <th className="align-right">Expenses</th>
                                                <th className="align-right">Net Saving</th>
                                                <th className="align-right">Net Loss</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tabScheduleD">
                        <div class="panel panel-default panel-primary2">                           
                            <div class="panel-body">
                                <div class="table-container">
                                    <table id="tblScheduleD" class="table table-striped table-bordered table-hover main-table">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>Name Of Organization</th>
                                                <th className="align-right">Sch.D</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/CustomScripts/GenerateRevenueReport.js"></script>


