@{
    ViewBag.Title = "Cash/Day Book";
}
<style type="text/css">
    .table-striped > tbody > tr:nth-of-type(even) {
        background-color: #f9f9f9;
    }
</style>
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Cash/Day Book</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">Cash/Day Book</div>
            <div class="panel-body">
                <div class="table-container1">
                    <div class="row table-top">
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>  Org.Name:</label>
                                <select id="ddlInstitute" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label> Starting Date:</label>
                                <div class="input-group date" id="dtStaringDate">
                                    <input id="txtStaringDate" type="text" class="form-control">
                                    <span class="input-group-addon">
                                        <i class="glyphicon glyphicon-th"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>  Ending Date:</label>
                                <div class="input-group date" id="dtEndingDate">
                                    <input id="txtEndingDate" type="text" class="form-control">
                                    <span class="input-group-addon">
                                        <i class="glyphicon glyphicon-th"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" id="btnView" class="btn btn-primary btn-column">View</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">Cash/Day Book</div>
            <div class="panel-body">             
                <div class="table-container">
                    <table id="tblCashDayBookReport" class="display-table table table-striped table-bordered table-hover main-table">
                        <thead>
                            <tr>
                                <th>SerialId</th>
                                <th width="80px">Particulars</th>
                                <th>Type</th>
                                <th>Vocher No</th>
                                <th className="align-right">Cash Amount</th>
                                <th className="align-right">Credit</th>
                                <th width="80px">Particulars</th>
                                <th>Type</th>
                                <th>Vocher No</th>
                                <th className="align-right">Cash Amount</th>
                                <th className="align-right">Debit</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/CustomScripts/CashDayBook.js"></script>
