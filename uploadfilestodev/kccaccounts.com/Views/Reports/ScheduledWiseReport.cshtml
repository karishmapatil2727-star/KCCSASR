
@{
    ViewBag.Title = "Schedule Wise Report";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Schedule Wise Report</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2" id="dvAccountGroup">
            <div class="panel-heading">Schedule Wise Report</div>
            <div class="panel-body">
                <div class="table-container">
                    <div class="row table-top schedule-pag-cls">
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>
                                    Org.Name:
                                </label>
                                <select id="ddlAccountGroupInstitute" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>
                                    Select Group:
                                </label>
                                <select id="ddlAccountGroups" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label>
                                    Starting Date:
                                </label>
                                <div class="input-group date" id="dtAccountGroupStaringDate">
                                    <input id="txtAccountGroupStaringDate" type="text" class="form-control">
                                    <span class="input-group-addon">
                                        <i class="glyphicon glyphicon-th"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label>
                                    Ending Date:
                                </label>
                                <div class="input-group date" id="dtAccountGroupEndingDate">
                                    <input id="txtAccountGroupEndingDate" type="text" class="form-control">
                                    <span class="input-group-addon">
                                        <i class="glyphicon glyphicon-th"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" id="btnAccountGroupView" class="btn btn-primary btn-column">View</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2" id="dvAccountGroup">
            <div class="panel-heading">Schedule Wise Report</div>
            <div class="panel-body">
                <div class="table-container">
                    <table id="tblScheduleWiseReport" class="table table-striped table-bordered table-hover main-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Name Of Organization</th>
                                <th className="align-right">Credit</th>
                                <th className="align-right">Debit</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr>
                                <th colspan="2">
                                    Total
                                </th>
                                <th><span id="spnTotalCredit"></span></th>
                                <th><span id="spnTotalDebit"></span></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/CustomScripts/ScheduledWiseReport.js"></script>
