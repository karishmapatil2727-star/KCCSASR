
@{
    ViewBag.Title = "ReconciliationReport";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Reconciliation Report</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">Reconciliation Report</div>
            <div class="panel-body">
                <div class="table-container">
                    <div class="row table-top reconciliation-pag-cls">
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>
                                    End Date:
                                </label>
                                <div class="input-group date" id="dtEndingDate">
                                    <input id="txtEndingDate" type="text" class="form-control">
                                    <span class="input-group-addon">
                                        <i class="glyphicon glyphicon-th"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>
                                    Org.Name:
                                </label>
                                <select id="ddlInstitute" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-primary btn-column" id="btnView">View</button>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">
                Reconciliation Report
            </div>
            <div class="panel-body">
                <div class="table-container">
                    <table id="tblReconciliationReport" class="table table-striped table-bordered table-hover main-table">
                        <thead>
                            <tr>
                                <th>My Ledger Name</th>
                                <th className="align-right">My Debit</th>
                                <th className="align-right">My Credit</th>
                                <th>Inst Ledger Name</th>
                                <th className="align-right">Inst Debit</th>
                                <th className="align-right">Inst Credit</th>
                                <th className="align-right">Difference</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_ReconciliationDatails")
<script src="~/Scripts/CustomScripts/ReconciliationReport.js"></script>