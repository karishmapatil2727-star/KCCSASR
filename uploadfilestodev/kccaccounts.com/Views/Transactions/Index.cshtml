@{
    ViewBag.Title = "Index";
}
<style type="text/css">
    .ui-combobox {
        width: 290px;
    }
</style>
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Accounting Vouchers</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">
                Add Transaction
                <span class="pull-right" id="spnOpenBalance">Cash Balance: @ViewBag.CashBalance</span>
            </div>
            <div class="panel-body">
                <div class="table-container1">
                    <div class="row">
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label>Date:</label>
                                <input type="text" id="txtDate" class="form-control" disabled />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>
                                    Deptt./College :
                                </label>
                                <select id="ddlInstitute" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label>
                                    Voucher Type:
                                </label>
                                <select id="ddlVocherTypes" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>
                                    Voucher No:
                                </label>
                                <input type="text" id="txtVoucherNo" class="form-control" disabled />
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label>
                                    Cheque No./Cash:
                                </label>
                                <input type="text" id="txtChequeOrCash" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <button type="submit" id="btnProceed" class="btn btn-primary btn-column btn-padding">Proceed</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2" id="dvAddnewLedger" style="display:none;">
            <div class="panel-heading">Add Account Ledger </div>
            <div class="panel-body">
                <div class="table-container">
                    <div class="row table-top add-pag-cls">
                        <div class="col-lg-2">
                            <div class="form-group">
                                <label>
                                    D/C
                                </label>
                                <select id="ddlCrorDr" class="form-control">
                                    <option value="C">C</option>
                                    <option value="D">D</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="form-group">
                                <label class="col-md-8">
                                    Account Ledger:
                                </label>
                                <select id="ddlLedgers" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-lg-2" id="colDebit">
                            <div class="form-group">
                                <label>
                                    Debit:
                                </label>
                                <input type="text" id="txtDebit" class="form-control" onkeypress="return validateFloatKeyPress(this,event);" />
                            </div>
                        </div>
                        <div class="col-lg-2" id="colCredit">
                            <div class="form-group">
                                <label>
                                    Credit:
                                </label>
                                <input type="text" id="txtCredit" class="form-control" onkeypress="return validateFloatKeyPress(this,event);" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button type="button" id="btnAddTolistProceed" class="btn btn-primary transactionProceed">Proceed</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2" id="dvNewLedgertable" style="display:none;">
            <div class="panel-heading">Account Ledger Information</div>
            <div class="panel-body">
                <div class="table-container">
                    <table id="tblNewLedger" class="table table-striped table-bordered table-hover main-table" style="width:100%">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>C/D</th>
                                <th>Ledger ID</th>
                                <th>Account Ledger</th>
                                <th class='align-right'>Debit</th>
                                <th class='align-right'>Credit</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4">Total:</td>
                                <td class='align-right'><label id="lblDebitAmount"></label></td>
                                <td class='align-right'><label id="lblCreditAmount"></label></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label> Master Narration:</label>
                            <input type="text" id="txtNarration" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="pull-right">
                            <button type="button" id="btnAddTransaction" class="btn btn-primary btn-space btn-padding">Add Transaction</button>
                            <button type="button" id="btnDeleteRow" class="btn btn-danger btn-padding">Delete ledger</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/CustomScripts/AddTransaction.js"></script>
