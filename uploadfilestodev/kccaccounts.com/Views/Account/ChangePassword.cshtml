
@{
    ViewBag.Title = "Change Password";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Change Password</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">
                <div class="panel-body">
                    <div class="table-container">
                        <div class="table">
                            <div class="row">
                                <div class="form-group">
                                    Current Password:

                                    <input type="text" class="form-control" id="txtCurrentPassword" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group">
                                    New Password:
                                    <input type="text" class="form-control" id="txtNewPassword" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group">
                                    Confirm Password:
                                    <input type="text" class="form-control" id="txtConfirmPassword" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                </div>
                                <div class="col-md-4">
                                    <button id="btnSubmit" type="submit" class="btn-primary">Submit</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/CustomScripts/ChangePassword.js"></script>