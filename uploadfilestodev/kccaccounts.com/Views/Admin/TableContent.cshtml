
@{
    ViewBag.Title = "Table Content";
}
<style type="text/css">
    .dataTables_filter {
        margin-bottom: 10px;
        margin-right: 15px;
    }
</style>
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Table Content</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">Table Content</div>
            <div class="panel-body">
                <div class="table-container1">
                    <div class="row table-top">
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>Org.Name:</label>
                                <select id="ddlInstitute" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>
                                    Starting Date:
                                </label>
                                <div class="input-group date" id="dtStaringDate">
                                    <input id="txtStaringDate" type="text" class="form-control">
                                    <span class="input-group-addon">
                                        <i class="glyphicon glyphicon-th"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>
                                    Ending Date:
                                </label>
                                <div class="input-group date" id="dtEndingDate">
                                    <input id="txtEndingDate" type="text" class="form-control">
                                    <span class="input-group-addon">
                                        <i class="glyphicon glyphicon-th"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" id="btnView" class="btn btn-primary btn-column btn-space">View</button>
                            <button type="submit" id="btnSave" class="btn btn-primary btn-column">Save</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">Table Content Information </div>
            <div class="panel-body">
                <div class="table-container">
                    <table id="tblTableContent" class="table table-striped table-bordered table-hover main-table">
                        <thead>
                            <tr>
                                <th>AccountId</th>
                                <th>Particulars</th>
                                <th class="editCell">Page Number</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/CustomScripts/TableContent.js"></script>
