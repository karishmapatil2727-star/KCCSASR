
@{
    ViewBag.Title = "ViewPassword";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">View Password</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">
                <div class="panel-body">
                    <div class="table-container">
                        <div class="table">
                            <div class="row">
                                <div class="col-md-5">
                                    <div class="form-group">
                                        <label>User Name:</label>
                                        <input type="text" class="form-control" id="txtUserName" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <button id="btnView" class="btn btn-primary btn-column">View</button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-10">
                                    <div class="form-group">
                                        <label class="btn-space">User Name:</label>
                                        <span id="spnUserName" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-10">
                                    <div class="form-group">
                                        <label class="btn-space">Password:</label>
                                        <span id="spnPassword" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-10">
                                    <div class="form-group">
                                        <label class="btn-space">College Name:</label>
                                        <span id="spnCollegeName" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/CustomScripts/ViewPassword.js"></script>