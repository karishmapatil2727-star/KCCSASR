@{
    ViewBag.Title = "Search Transaction";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Search a Transactions</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">Search Transactions</div>
            <div class="panel-body">
                <div class="table-container1">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label>Receipt no. or Cheque no.</label>
                                <input id="txtSeachValue" class="form-control" placeholder="Please enter receipt no. or cheque number">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <button type="submit" id="btnViewtransaction" class="btn btn-primary btn-column">View</button>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">
                List Of Transaction Vouchers
            </div>
            <div class="panel-body">
                <div class="table-container">
                    <table class="table-fixed table table-striped table-bordered table-hover main-table" id="tblVocherList">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>V.Type</th>
                                <th>V. No</th>
                                <th>Cheque No.</th>
                                <th>Particular</th>
                                <th className="align-right">Debit</th>
                                <th className="align-right">Credit</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr>
                                <th>Total</th>
                                <th colspan="4"></th>
                                <th><span id="spnDebitAmount"></span></th>
                                <th><span id="spnCreditAmount"></span></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/CustomScripts/TransactionSearch.js"></script>
