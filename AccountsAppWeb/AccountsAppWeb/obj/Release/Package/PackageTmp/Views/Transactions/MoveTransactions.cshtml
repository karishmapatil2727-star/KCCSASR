
@{
    ViewBag.Title = "MoveTransactions";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Move Transaction</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">Move Transaction</div>
            <div class="panel-body">
                <div class="table-container">
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>From Ledger</label>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="form-group">
                                <select id="ddlFromLedgers" class="form-control"></select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label> To Ledger</label>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="form-group">
                                <select id="ddlToLedgers" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <button id="btnMoveTransactions" type="button" class="btn btn-primary">Move Transactions</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/Scripts/CustomScripts/MoveTransactions.js"></script>