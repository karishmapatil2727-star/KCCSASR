  <nlog xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd" autoReload="true" throwExceptions="false" internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log" xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <variable name="appName" value="C:\www.dev.kccsasr.com\Logs" />
    <targets async="true">
      <target xsi:type="File" name="default" layout="${longdate} - ${level:uppercase=true}: ${message}${onexception:${newline}EXCEPTION\: ${exception:format=ToString}}" fileName="${appName}\Debug.log" keepFileOpen="false" archiveFileName="${appName}\Debug_${shortdate}.{##}.log" archiveNumbering="Sequence" archiveEvery="Month" maxArchiveFiles="30" />
    </targets>
    <rules>
      <logger name="acc_Logger" writeTo="default" minlevel="Warn" />
    </rules>
  </nlog>
