
@{
    ViewBag.Title = "View Notification";
}
<style type="text/css">
    div.dt-buttons {
        margin-bottom: 10px;
        margin-right: 15px;
    }
</style>
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Notifications Report</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">Show All Notification</div>
            <div class="panel-body">
                <div class="table-container">
                    <div class="row">
                        <div class="col-md-12">
                            <button type="button" id="btnShowAll" class="btn btn-primary btn-column">Show All</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default panel-primary2">
            <div class="panel-heading">View Notification</div>
            <div class="panel-body">
                <div class="table-container">
                    <table id="tblViewNotificationReport" class="table table-striped table-bordered table-hover main-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Date</th>
                                <th>Institution</th>
                                <th>V.Type</th>
                                <th>V.No</th>
                                <th>Cheque No.</th>
                                <th width="250px">Particulars</th>
                                <th className="align-right">Debit</th>
                                <th className="align-right">Credit</th>
                                <th>Submit</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/CustomScripts/ViewNotification.js"></script>
